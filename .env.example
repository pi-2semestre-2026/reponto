# Copie para .env. Todas as variáveis têm default no docker-compose.yml;
# preencha só o que quiser mudar. O .env real é ignorado pelo git.

# IA (opcional). Vazia = categorização por palavras-chave e explicações por template.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Segurança do JWT. Troque fora do ambiente de desenvolvimento.
SECRET_KEY=reponto-dev-secret

# Aprendizado: janela máxima de observação e meia-vida do decaimento (dias).
OBS_WINDOW_DAYS=90
EMA_HALF_LIFE_DAYS=30

# Portas publicadas no host.
BACKEND_PORT=8000
FRONTEND_PORT=3000
CAIXA_PORT=3301

# URL do backend vista pelo navegador. É gravada no build do frontend:
# mudou aqui, rode `docker compose up -d --build frontend`. Deve bater com BACKEND_PORT.
NEXT_PUBLIC_API_URL=http://localhost:8000
